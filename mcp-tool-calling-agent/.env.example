# MCP Tool-Calling Agent - Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ============================================================
# LLM CONFIGURATION — choose ONE provider
# ============================================================

# Option 1: OpenRouter (recommended — access many models with one key)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# Option 2: OpenAI direct (uncomment to use)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key-here
# LLM_MODEL=gpt-4o-mini

# Option 3: Anthropic direct (uncomment to use)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# LLM_MODEL=claude-3-haiku-20240307

# ============================================================
# DEMO MODE
# ============================================================
DEMO_MODE=true

# ============================================================
# DATA PATHS (used in DEMO_MODE)
# ============================================================
DATA_DIR=data
DOCUMENTS_DIR=documents

# ============================================================
# MCP SERVER CONFIGURATION
# ============================================================
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000

# ============================================================
# DATABRICKS (for production — leave blank in DEMO_MODE)
# Authentication uses OAuth — no token/PAT required.
# ============================================================
# DATABRICKS_SERVER_HOSTNAME=your-workspace.azuredatabricks.net
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
# DATABRICKS_CATALOG=your_catalog
# DATABRICKS_SCHEMA=your_schema
# VECTOR_SEARCH_ENDPOINT=your-vector-search-endpoint

# ============================================================
# APPLICATION SETTINGS
# ============================================================
LOG_LEVEL=INFO
